<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Version>0.0.2.6</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>GPC.Model.Data</RootNamespace>
    <Configurations>Debug;Release;DebugLocalLibs</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Model\GPCModel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- the geometry of the sections (centroids) in the map of the catalogs -->
    <Reference Include="GPCGeometry">
      <HintPath>..\..\Geometry\GPCGeometry\bin\Release\netstandard2.0\GPCGeometry.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- catalogs of commercial sections, extracted by tools/section-catalogs -->
    <EmbeddedResource Include="Sections\Catalogs\*.csv" LogicalName="GPC.ModelData.Sections.Catalogs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Sections\TorsionDeviations.csv" LogicalName="GPC.ModelData.Sections.TorsionDeviations.csv" />
  </ItemGroup>

</Project>
